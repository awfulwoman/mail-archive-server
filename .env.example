# Root containing one directory per account, each a standard Maildir tree
# (cur/new/tmp, SubFolders Verbatim). This service both writes here (via mbsync,
# which it orchestrates) and reads here (to index and serve search).
MAIL_ARCHIVE_MAILDIR_PATH=/data/mail

# SQLite index this service owns. Created on first run.
MAIL_ARCHIVE_DB_PATH=/data/state/index.db

MAIL_ARCHIVE_HOST=0.0.0.0
MAIL_ARCHIVE_PORT=4103

# --- Accounts to sync -------------------------------------------------------
# One block per account. `name` becomes a Maildir subdirectory, an mbsync
# channel, and the account name reported by the API — keep it matching
# ^[a-z0-9][a-z0-9_-]*$. PORT defaults to 993; PATTERNS defaults to "*" (set it
# to exclude provider-specific folders, e.g. a Gmail account excluding
# "[Gmail]/All Mail" to avoid double-counting).
#
# An account with no IMAP credentials configured here is still searchable if
# its folder already exists under MAIL_ARCHIVE_MAILDIR_PATH (e.g. populated by
# some other means) — it just won't be actively synced by this service.
MAIL_ARCHIVE_IMAP_ACCOUNTS__personal__HOST=imap.example.com
MAIL_ARCHIVE_IMAP_ACCOUNTS__personal__USERNAME=charlie@example.com
MAIL_ARCHIVE_IMAP_ACCOUNTS__personal__PASSWORD=change-me

# --- Sync scheduling ---------------------------------------------------------
# The service syncs (mbsync) then reindexes on this interval, in the
# background — starting promptly on boot, not waiting out the first interval.
MAIL_ARCHIVE_SYNC_INTERVAL_SECONDS=3600
MAIL_ARCHIVE_MBSYNC_BIN=mbsync
MAIL_ARCHIVE_MBSYNCRC_PATH=/data/state/mbsyncrc

# Where mbsync's SyncState directories live, one subdirectory per account
# (e.g. {this}/personal/INBOX). Defaults under MAIL_ARCHIVE_MAILDIR_PATH; only
# override if you need it elsewhere.
# MAIL_ARCHIVE_MBSYNC_STATE_PATH=/data/mail/.mbsync

# Folders excluded from search by default. A bare name applies to every account;
# "account:folder" scopes it to one account (e.g. a provider-specific folder name).
MAIL_ARCHIVE_EXCLUDE_FOLDERS=Trash,Junk

# --- Access tokens ------------------------------------------------------------
# One label per token. ACCOUNTS is "*" (every account, including ones added
# later) or a comma-separated allowlist. The token is the actual security
# boundary — see README "Token scoping". A wildcard-scoped token is required
# to call POST /sync or POST /reindex.
MAIL_ARCHIVE_TOKENS__gateway__SECRET=change-me
MAIL_ARCHIVE_TOKENS__gateway__ACCOUNTS=*
