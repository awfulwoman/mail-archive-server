# Root containing one directory per account, each a standard Maildir tree
# (cur/new/tmp, SubFolders Verbatim). Read-only — this service never writes here.
MAIL_ARCHIVE_MAILDIR_PATH=/slowpool/charlie/email

# SQLite index this service owns. Created on first run.
MAIL_ARCHIVE_DB_PATH=/home/awful/.local/state/mail-archive-server/index.db

MAIL_ARCHIVE_HOST=0.0.0.0
MAIL_ARCHIVE_PORT=4103

# Where mbsync's SyncState directories live, one subdirectory per account
# (e.g. {this}/personal/INBOX). Used to compute last_sync_at / staleness.
MAIL_ARCHIVE_MBSYNC_STATE_PATH=/slowpool/charlie/email/.mbsync

# Folders excluded from search by default. A bare name applies to every account;
# "account:folder" scopes it to one account (e.g. a provider-specific folder name).
MAIL_ARCHIVE_EXCLUDE_FOLDERS=Trash,Junk

# Bearer tokens, one label per token. ACCOUNTS is "*" (every account the Maildir
# holds, including ones added later) or a comma-separated allowlist. The token is
# the actual security boundary — see README "Token scoping".
MAIL_ARCHIVE_TOKENS__gateway__SECRET=change-me
MAIL_ARCHIVE_TOKENS__gateway__ACCOUNTS=*
